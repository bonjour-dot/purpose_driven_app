# Public in the browser; this is an OAuth client ID, never a client secret.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Netlify Functions only — keep these in Netlify environment variables, never in public/.
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT/exec
APP_GATEWAY_SHARED_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ALLOWED_ORIGINS=https://your-site.netlify.app,http://localhost:8888
